<UserControl
    x:Class="EZDIT.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderNeutralL1Brush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderNeutralL1Brush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="26">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="D" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource AccentButtonTextBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="EZ DIT" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="SidebarSettingsLabel" x:Uid="SidebarSettingsLabel" Text="设置" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock x:Name="SettingsSectionLabel" x:Uid="SettingsSectionLabel" Text="设置" Margin="10,0,0,3" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="AppearanceNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Click="AppearanceNavButton_Click" Background="{StaticResource ControlSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                                    <Image Source="ms-appx:///Assets/Icons/design-palette.svg" Width="15" Height="15" />
                                </Border>
                                <TextBlock x:Name="AppearanceNavText" x:Uid="AppearanceNavText" Text="外观" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GeneralNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Click="GeneralNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                                    <Image Source="ms-appx:///Assets/Icons/settings.svg" Width="15" Height="15" />
                                </Border>
                                <TextBlock x:Name="GeneralNavText" x:Uid="GeneralNavText" Text="常规" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AboutNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Click="AboutNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                                    <Image Source="ms-appx:///Assets/Icons/information_simple.svg" Width="15" Height="15" />
                                </Border>
                                <TextBlock x:Name="AboutNavText" x:Uid="AboutNavText" Text="关于" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="2" Click="BackButton_Click" Height="40"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,0" Background="{StaticResource ControlSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock x:Name="BackToTaskText" x:Uid="BackToTaskText" Text="返回任务" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="920" HorizontalAlignment="Left" Margin="34,34,34,48">
                <StackPanel x:Name="AppearancePanel" Spacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AppearanceTitle" x:Uid="AppearanceTitle" Text="外观" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="AppearanceDesc" x:Uid="AppearanceDesc" Text="选择应用的明暗外观与强调色。" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="20">
                            <TextBlock x:Name="ColorModeSectionTitle" x:Uid="ColorModeSectionTitle" Text="颜色模式与主题色" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ColorModeLabel" x:Uid="ColorModeLabel" Text="颜色模式" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" MinWidth="260"
                                          HorizontalAlignment="Stretch" SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" />
                                    <ComboBoxItem Content="浅色模式" />
                                    <ComboBoxItem Content="深色模式" />
                                </ComboBox>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />
                            <TextBlock x:Name="AccentColorLabel" x:Uid="AccentColorLabel" Text="主题色" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Tag="System" Click="AccentButton_Click" MinWidth="116" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Ellipse Width="20" Height="20" Fill="{StaticResource WindowsAccentPreviewBrush}" />
                                        <TextBlock x:Uid="WinAccentText" Text="Windows 主题色" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="Seafoam" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnSeafoam" ToolTipService.ToolTip="海沫绿">
                                    <Ellipse Width="24" Height="24" Fill="#00B7C3" />
                                </Button>
                                <Button Tag="BrightRose" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnBrightRose" ToolTipService.ToolTip="亮玫红">
                                    <Ellipse Width="24" Height="24" Fill="#EA005E" />
                                </Button>
                                <Button Tag="Gold" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnGold" ToolTipService.ToolTip="黄金色">
                                    <Ellipse Width="24" Height="24" Fill="#FFB900" />
                                </Button>
                                <Button Tag="Mint" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnMint" ToolTipService.ToolTip="浅薄荷色">
                                    <Ellipse Width="24" Height="24" Fill="#00B294" />
                                </Button>
                                <Button Tag="PurpleShadow" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnPurpleShadow" ToolTipService.ToolTip="紫影色">
                                    <Ellipse Width="24" Height="24" Fill="#8E8CD8" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="AccentSelectionText" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="GeneralPanel" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="GeneralTitle" x:Uid="GeneralTitle" Text="常规" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="GeneralDesc" x:Uid="GeneralDesc" Text="设置界面语言以及日志与报告的默认位置。" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="22">
                            <TextBlock x:Name="LangFileSectionTitle" x:Uid="LangFileSectionTitle" Text="语言与文件" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLabel" x:Uid="LanguageLabel" Text="语言" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" MinWidth="260"
                                          HorizontalAlignment="Stretch" SelectionChanged="LanguageComboBox_SelectionChanged">
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />
                            <TextBlock x:Name="LogPathLabel" x:Uid="LogPathLabel" Text="日志与报告默认保存位置" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputDirectoryTextBox" IsReadOnly="True"
                                         Background="{StaticResource ControlSecondaryBrush}" />
                                <Button Grid.Column="1" Click="BrowseDirectoryButton_Click"
                                        x:Name="BrowseFolderButton" x:Uid="BrowseFolderButton" Content="选择文件夹" Padding="16,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AboutPanel" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AboutTitle" x:Uid="AboutTitle" Text="关于" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutDesc" x:Uid="AboutDesc" Text="查看版本信息并访问 EZ DIT 项目仓库。" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="18">
                            <TextBlock x:Name="AppInfoTitle" x:Uid="AppInfoTitle" Text="应用信息" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VersionLabel" x:Uid="VersionLabel" Text="版本" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionTextBlock" Grid.Column="1" />
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RepoLabel" x:Uid="RepoLabel" Text="项目仓库" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="RepositoryButton_Click"
                                        HorizontalAlignment="Left" Padding="14,0" Height="40">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#FFFFFF">
                                            <Image Source="ms-appx:///Assets/Icons/Github.svg" Width="17" Height="17" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="MEMZ-Edge01/EZ-DIT" FontWeight="SemiBold" />
                                            <TextBlock x:Name="OpenGitHubText" x:Uid="OpenGitHubText" Text="在 GitHub 中打开" FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
