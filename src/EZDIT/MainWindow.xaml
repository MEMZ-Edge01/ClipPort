<Window
    x:Class="EZDIT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EZ DIT-beta">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="#15171A">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="D" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="White" />
                </Border>
                <TextBlock x:Name="AppTitleText" Text="EZ DIT-beta" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid.Resources>
                    <SolidColorBrush x:Key="ListViewItemCheckBrush" Color="White" />
                    <SolidColorBrush x:Key="ListViewItemCheckPressedBrush" Color="White" />
                    <SolidColorBrush x:Key="ListViewItemCheckDisabledBrush" Color="#8F8AAB" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxBrush" Color="#25282E" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBrush" Color="#343740" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBrush" Color="#3B3F49" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxDisabledBrush" Color="#25282E" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedBrush" Color="#7567F8" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" Color="#897DFF" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedPressedBrush" Color="#6558DD" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxSelectedDisabledBrush" Color="#514A83" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxBorderBrush" Color="#D7D3FF" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxPointerOverBorderBrush" Color="White" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxPressedBorderBrush" Color="#B9B2FF" />
                    <SolidColorBrush x:Key="ListViewItemCheckBoxDisabledBorderBrush" Color="#625E73" />
                    <Style x:Key="JobListItemStyle" TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                    <DataTemplate x:Key="JobCardTemplate">
                        <Border Background="#2B2E35" CornerRadius="8" Padding="18"
                                Loaded="NewJobCard_Loaded" Unloaded="NewJobCard_Unloaded">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                                    <FontIcon Glyph="{Binding StatusGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="14" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,30,16,20" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="NewJobButton" Click="ConcurrentNewJobButton_Click" Height="46" Padding="16,0"
                                Background="{StaticResource AccentBrush}" CornerRadius="23">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon Glyph="&#xE710;" FontSize="15" />
                                <TextBlock Text="创建任务" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MultiSelectButton" Click="MultiSelectButton_Click" Height="46" Padding="14,0"
                                Background="#292C32" CornerRadius="23">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE762;" FontSize="15" />
                                <TextBlock x:Name="MultiSelectButtonText" Text="多选" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="BatchActionPanel" Visibility="Collapsed" Spacing="8">
                        <TextBlock x:Name="BatchSelectionText" Text="已选择 0 个任务"
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BatchDeleteButton" Click="BatchDeleteButton_Click"
                                    Height="38" Padding="12,0" IsEnabled="False"
                                    Background="#4A2D31" CornerRadius="7">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="批量删除" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BatchReportButton" Click="BatchReportButton_Click"
                                    Height="38" Padding="12,0" IsEnabled="False"
                                    Background="#292C32" CornerRadius="7">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                                    <TextBlock Text="批量创建报告" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="&#x65B0;&#x4EFB;&#x52A1;" Margin="20,0,20,12"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    <ListView x:Name="NewJobsList" Grid.Row="1" MaxHeight="260" Margin="0" Padding="20,0,20,0"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="NewJobsList_ItemClick"
                              SelectionChanged="NewJobsList_SelectionChanged" HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource JobListItemStyle}"
                              ItemTemplate="{StaticResource JobCardTemplate}" />
                    <TextBlock x:Name="NewJobsEmptyText" Grid.Row="1" Text="&#x6682;&#x65E0;&#x65B0;&#x4EFB;&#x52A1;"
                               Margin="20,18" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="历史任务" Margin="20,0,20,12" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    <ListView x:Name="HistoryList" Grid.Row="1" Margin="0" Padding="20,0,20,0"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"
                              HorizontalContentAlignment="Stretch" SelectionChanged="ConcurrentHistoryList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2B2E35" CornerRadius="8" Padding="18">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                                            <FontIcon Glyph="{Binding StatusGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="14" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="HistoryEmptyText" Grid.Row="1" Text="暂无历史任务"
                               Margin="20,18" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </Grid>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="46,32,46,38" MaxWidth="1180" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="HeroNameText" Text="准备新任务" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentFileText" Text="请选择源目录和目标目录" Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxWidth="650" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <FontIcon x:Name="CompletionIcon" Glyph="&#xE73E;" FontSize="27"
                                          Foreground="#00BFA5" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusText" Text="等待设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#AEB4C5" VerticalAlignment="Center" />
                                <TextBlock x:Name="PercentText" Text="0.00%" FontSize="32" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Spacing="10">
                                <Button x:Name="PauseButton" Click="ConcurrentPauseButton_Click" IsEnabled="False" Height="40"
                                        Padding="16,0" Background="#2B2E35" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13" />
                                        <TextBlock x:Name="PauseText" Text="暂停" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelButton" Click="ConcurrentCancelButton_Click" IsEnabled="False" Height="40"
                                        Padding="16,0" Background="#2B2E35" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        <TextBlock Text="取消" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteJobButton" Click="ConcurrentDeleteJobButton_Click" Visibility="Collapsed" Height="40"
                                        Padding="16,0" Background="#2B2E35" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock Text="删除记录" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="9" Background="#343740">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="源目录 / 存储卡" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="SourcePathText" Text="尚未选择" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="SourcePickerButton" Grid.Column="2" Click="ChooseSourceButton_Click"
                                        ToolTipService.ToolTip="选择源目录" Width="38" Height="38" Padding="0"
                                        Background="Transparent" CornerRadius="19">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="9" Background="#343740">
                                    <FontIcon Glyph="&#xE838;" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="拷卡目的地" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DestinationPathText" Text="尚未选择" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="DestinationPickerButton" Grid.Column="2" Click="ChooseDestinationButton_Click"
                                        ToolTipService.ToolTip="选择目标目录" Width="38" Height="38" Padding="0"
                                        Background="Transparent" CornerRadius="19">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="34" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="TotalSizeText" Text="--" FontWeight="SemiBold" />
                                <TextBlock Text="文件大小" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TotalCountText" Text="--" FontWeight="SemiBold" />
                                <TextBlock Text="文件数" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="StartTimeText" Text="--" FontWeight="SemiBold" />
                                <TextBlock Text="创建时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="EndTimeText" Text="--" FontWeight="SemiBold" />
                                <TextBlock Text="结束时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DurationText" Text="--" FontWeight="SemiBold" />
                                <TextBlock Text="累计用时" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="StartButton" Click="ConcurrentStartButton_Click" Padding="22,10"
                                    Background="{StaticResource AccentBrush}" CornerRadius="7" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                    <TextBlock Text="开始拷卡" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,26,0,0" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <StackPanel>
                            <Grid Padding="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    <TextBlock Text="任务进度" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="PhaseText" Text="等待开始" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </Grid>

                            <ProgressBar x:Name="OverallProgress" Height="4" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource AccentBrush}" Background="#343740" />

                            <Grid Padding="20,17" Background="#25282E">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="拷贝" Foreground="#B9B2FF" FontWeight="SemiBold" />
                                <Grid Grid.Column="1" Margin="0,0,28,0">
                                    <ProgressBar x:Name="CopyProgress" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" />
                                    <Border x:Name="CopyCompletedBadge" Visibility="Collapsed" Background="#3B3760" CornerRadius="5" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#B9B2FF" />
                                            <TextBlock x:Name="CopyCompletedText" Text="已完成" FontWeight="SemiBold" Foreground="#D7D3FF" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" x:Name="CopySpeedText" Text="0 B/s" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" x:Name="CopyTimeText" Text="00:00:00" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" x:Name="CopyCountText" Text="0/0" HorizontalAlignment="Right" />
                            </Grid>

                            <Grid Padding="20,17" Background="#20302D">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SHA-256 校验" Foreground="#78DDB8" FontWeight="SemiBold" />
                                <Grid Grid.Column="1" Margin="0,0,28,0">
                                    <ProgressBar x:Name="VerifyProgress" Height="5" Minimum="0" Maximum="100" Foreground="#55C79A" />
                                    <Border x:Name="VerifyCompletedBadge" Visibility="Collapsed" Background="#294A42" CornerRadius="5" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="#5DE0B0" />
                                            <TextBlock x:Name="VerifyCompletedText" Text="已完成" FontWeight="SemiBold" Foreground="#93E8C8" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" x:Name="VerifySpeedText" Text="0 B/s" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" x:Name="VerifyTimeText" Text="00:00:00" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" x:Name="VerifyCountText" Text="0/0" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DuplicatePanel" Grid.Row="4" Margin="0,18,0,0"
                            Background="{StaticResource PanelBrush}" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Padding="20,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="#FFB86B" />
                                    <TextBlock x:Name="DuplicateSummaryText" Text="发现重复文件" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="DuplicateSelectionHint" Grid.Column="1" Text="请逐个选择处理方式"
                                           FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>

                            <Border Background="#25282E" Padding="16,10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="DuplicateSelectAllCheckBox" Content="全选" IsThreeState="True"
                                              Checked="ConcurrentDuplicateSelectAllCheckBox_Changed"
                                              Unchecked="ConcurrentDuplicateSelectAllCheckBox_Changed" />
                                    <TextBlock Grid.Column="1" Text="可勾选多项后批量设置；仍可在每行单独修改。"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                                        <Button x:Name="BatchOverwriteButton" Content="覆盖所选"
                                                Click="ConcurrentBatchDuplicateOverwrite_Click" IsEnabled="False" Padding="11,6" />
                                        <Button x:Name="BatchSkipButton" Content="跳过所选"
                                                Click="ConcurrentBatchDuplicateSkip_Click" IsEnabled="False" Padding="11,6" />
                                        <Button x:Name="BatchCreateCopyButton" Content="所选创建副本"
                                                Click="ConcurrentBatchDuplicateCreateCopy_Click" IsEnabled="False" Padding="11,6" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListView x:Name="DuplicateList" MaxHeight="330" SelectionMode="None" Padding="16,12,16,4"
                                      Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="CornerRadius" Value="7" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Expander HorizontalAlignment="Stretch" Background="#30333B">
                                            <Expander.Header>
                                                <Grid MinHeight="48" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanChoose}"
                                                              Click="ConcurrentDuplicateSelectionCheckBox_Click"
                                                              VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DecisionText}"
                                                               VerticalAlignment="Center" Foreground="#FFCA8A"
                                                               HorizontalAlignment="Center" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <Button Content="覆盖" Tag="{Binding}" Click="DuplicateOverwrite_Click"
                                                                IsEnabled="{Binding CanChoose}" Padding="9,5" />
                                                        <Button Content="跳过" Tag="{Binding}" Click="DuplicateSkip_Click"
                                                                IsEnabled="{Binding CanChoose}" Padding="9,5" />
                                                        <Button Content="创建副本" Tag="{Binding}" Click="DuplicateCreateCopy_Click"
                                                                IsEnabled="{Binding CanChoose}" Padding="9,5" />
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <Grid Padding="42,4,12,14" RowSpacing="9" ColumnSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="文件名称" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Text="来源位置" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="1" Grid.Column="2" Content="在资源管理器中选择" Tag="{Binding}"
                                                        Click="OpenDuplicateSource_Click" Padding="10,5" />
                                                <TextBlock Grid.Row="2" Text="冲突位置" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DestinationPath}" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Row="2" Grid.Column="2" Content="在资源管理器中选择" Tag="{Binding}"
                                                        Click="OpenDuplicateDestination_Click" Padding="10,5" />
                                            </Grid>
                                        </Expander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid Padding="16,6,16,16">
                                <Button x:Name="ApplyDuplicateChoicesButton" Content="应用选择并继续"
                                        Click="ApplyDuplicateChoicesButton_Click" IsEnabled="False"
                                        HorizontalAlignment="Right" Background="{StaticResource AccentBrush}" Padding="18,9" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FailedFilesPanel" Grid.Row="5" Margin="0,18,0,0"
                            Background="#2A2022" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Padding="20,17" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="#FF7058" />
                                    <TextBlock x:Name="FailedFilesSummaryText"
                                               Text="&#x5931;&#x8D25;&#x6587;&#x4EF6;" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="RetryFailedFilesButton"
                                            Content="&#x91CD;&#x8BD5;&#x6240;&#x9009;"
                                            Click="ConcurrentRetryFailedFiles_Click"
                                            Background="{StaticResource AccentBrush}" Padding="14,7" />
                                    <Button x:Name="SkipFailedFilesButton"
                                            Content="&#x8DF3;&#x8FC7;&#x6240;&#x9009;"
                                            Click="ConcurrentSkipFailedFiles_Click" Padding="14,7" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="&#x52FE;&#x9009;&#x6587;&#x4EF6;&#x540E;&#x9009;&#x62E9;&#x91CD;&#x8BD5;&#x6216;&#x8DF3;&#x8FC7;&#xFF1B;&#x672A;&#x5904;&#x7406;&#x9879;&#x4F1A;&#x7EE7;&#x7EED;&#x4FDD;&#x7559;&#x3002;"
                                       Margin="20,0,20,12" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />

                            <ListView x:Name="FailedFilesList" MaxHeight="330" SelectionMode="None"
                                      Padding="16,0,16,12" Background="Transparent" BorderThickness="0"
                                      HorizontalContentAlignment="Stretch">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#343034" CornerRadius="7" Padding="14,11">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Click="ConcurrentFailedFileSelection_Click" />
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Text="{Binding RelativePath}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#FF9B8A"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StageText}" Foreground="#FFB09F" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="6" Margin="0,18,0,0" Background="#191B1F" CornerRadius="8" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" x:Name="LogText" Margin="10,0,0,0" Text="就绪。选择目录后即可开始。"
                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
        <ContentDialog x:Name="NewTaskDialog" Grid.RowSpan="2" Title="新建拷卡任务"
                       PrimaryButtonText="开始任务" CloseButtonText="取消" DefaultButton="Primary">
            <ScrollViewer Width="500" MaxHeight="590" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Padding="0,4,0,2">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="19" />
                            <TextBlock Text="数据源" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="DialogSourceButton" Click="DialogSourceButton_Click" Height="76"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="#30333B" CornerRadius="6" Padding="18,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="24" />
                                <TextBlock x:Name="DialogSourcePathText" Grid.Column="1" Margin="14,0,0,0"
                                           Text="请选择源目录或存储卡" Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="19" />
                            <TextBlock Text="拷贝" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="拷贝目的地" FontWeight="SemiBold" />
                        <Button x:Name="DialogDestinationButton" Click="DialogDestinationButton_Click" Height="76"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="#30333B" CornerRadius="6" Padding="18,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="24" />
                                <TextBlock x:Name="DialogDestinationPathText" Grid.Column="1" Margin="14,0,0,0"
                                           Text="请选择文件拷贝目的地" Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                       </Button>
                    </StackPanel>
                    <StackPanel Spacing="9">
                        <ToggleSwitch x:Name="EnableCopyToggle" Header="拷贝文件" IsOn="True" HorizontalAlignment="Stretch" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="拷贝目的地文件夹名" Foreground="White" />
                            <TextBox x:Name="DialogDestinationSubfolderName"
                                     PlaceholderText=""
                                     HorizontalAlignment="Stretch" />
                            <TextBlock Text="留空即不创建子文件夹" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="重复项处理" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                            <RadioButton x:Name="AskExistingRadio" Content="询问" IsChecked="True"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                            <RadioButton x:Name="OverwriteExistingRadio" Content="覆盖"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                            <RadioButton x:Name="SkipExistingRadio" Content="跳过"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                            <RadioButton x:Name="CreateCopyRadio" Content="创建副本"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                        </StackPanel>
                        <TextBlock Text="询问模式会先继续处理其他文件，再逐个处理检测到的重复文件。"
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="5" Visibility="Collapsed">
                        <ToggleSwitch x:Name="UseFastCopyAlgorithmToggle"
                                      IsEnabled="False"
                                      Header="使用 FastCopy 算法"
                                      OffContent="关闭"
                                      OnContent="开启"
                                      IsOn="False"
                                      HorizontalAlignment="Stretch" />
                        <TextBlock Text="使用原生流水线复制引擎；不可用时自动回退到托管流水线。文件大小、进度和剩余时间仍会正常显示。"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="VerifyFilesToggle" Header="文件校验（SHA-256）" IsOn="True" HorizontalAlignment="Stretch" />
                    <ToggleSwitch x:Name="PreventSleepToggle"
                                  Header="&#x4EFB;&#x52A1;&#x671F;&#x95F4;&#x963B;&#x6B62;&#x7535;&#x8111;&#x4F11;&#x7720;"
                                  IsOn="True" HorizontalAlignment="Stretch" />
                    <StackPanel Spacing="5">
                        <ToggleSwitch x:Name="PriorityExecutionToggle"
                                      Header="&#x4F18;&#x5148;&#x6267;&#x884C;"
                                      OffContent="&#x5173;&#x95ED;" OnContent="&#x5F00;&#x542F;"
                                      IsOn="False"
                                      HorizontalAlignment="Stretch" />
                        <TextBlock Text="&#x4F18;&#x5148;&#x4EFB;&#x52A1;&#x4F1A;&#x5E76;&#x884C;&#x6267;&#x884C;&#xFF1B;&#x5176;&#x4ED6;&#x4EFB;&#x52A1;&#x5C06;&#x5728;&#x5B89;&#x5168;&#x68C0;&#x67E5;&#x70B9;&#x7B49;&#x5F85;&#xFF0C;&#x76F4;&#x5230;&#x5168;&#x90E8;&#x4F18;&#x5148;&#x4EFB;&#x52A1;&#x7ED3;&#x675F;&#x3002;"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>    </Grid>
</Window>
