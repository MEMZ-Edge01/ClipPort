{
  "name": "clipport-fnos-web",
  "private": true,
  "version": "1.0.0-beta",
  "type": "module",
  "scripts": {
    "generate:i18n": "node scripts/generate-i18n.mjs",
    "predev": "npm run generate:i18n",
    "prebuild": "npm run generate:i18n",
    "pretypecheck": "npm run generate:i18n",
    "prelint": "npm run generate:i18n",
    "pretest": "npm run generate:i18n",
    "dev": "vite",
    "build": "tsc -b && vite build",
