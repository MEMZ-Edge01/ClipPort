<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ClipPort</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <!--
    Keep the first extraction mechanically small: the portable sources remain in
    their historical locations while Windows, fnOS and tests consume one assembly.
    New cross-platform code belongs in this project directly.
  -->
  <ItemGroup>
    <Compile Include="..\ClipPort\Models\AppSettings.cs" Link="Models\AppSettings.cs" />
    <Compile Include="..\ClipPort\Models\CopyModels.cs" Link="Models\CopyModels.cs" />
    <Compile Include="..\ClipPort\Models\CopyThroughputSampler.cs" Link="Models\CopyThroughputSampler.cs" />
    <Compile Include="..\ClipPort\Models\WaveformTimeline.cs" Link="Models\WaveformTimeline.cs" />
    <Compile Include="..\ClipPort\Models\ResponsiveLayout.cs" Link="Models\ResponsiveLayout.cs" />
    <Compile Include="..\ClipPort\Models\DisplayFormatting.cs" Link="Models\DisplayFormatting.cs" />
    <Compile Include="..\ClipPort\Models\PhaseProgressObservation.cs" Link="Models\PhaseProgressObservation.cs" />
    <Compile Include="..\ClipPort\Models\JobHistoryItem.cs" Link="Models\JobHistoryItem.cs" />
    <Compile Include="..\ClipPort\Services\FileCopyService.cs" Link="Services\FileCopyService.cs" />
    <Compile Include="..\ClipPort\Services\BackgroundVerificationWorker.cs" Link="Services\BackgroundVerificationWorker.cs" />
    <Compile Include="..\ClipPort\Services\SourceScanner.cs" Link="Services\SourceScanner.cs" />
    <Compile Include="..\ClipPort\Services\HistoryRetentionPolicy.cs" Link="Services\HistoryRetentionPolicy.cs" />
    <Compile Include="..\ClipPort\Services\NativeCopyEngine.cs" Link="Services\NativeCopyEngine.cs" />
    <Compile Include="..\ClipPort\Services\JobHistoryService.cs" Link="Services\JobHistoryService.cs" />
    <Compile Include="..\ClipPort\Services\CopyJobScheduler.cs" Link="Services\CopyJobScheduler.cs" />
    <Compile Include="..\ClipPort\Services\ResourceService.cs" Link="Services\ResourceService.cs" />
    <Compile Include="..\ClipPort\Services\PathSafety.cs" Link="Services\PathSafety.cs" />
    <Compile Include="..\ClipPort\Services\TaskReportBuilder.cs" Link="Services\TaskReportBuilder.cs" />
    <Compile Include="..\ClipPort\Services\NotificationService.cs" Link="Services\NotificationService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ClipPort\Strings\zh-CN\Resources.resw"
             Link="Strings\zh-CN\Resources.resw"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ClipPort\Strings\en-US\Resources.resw"
             Link="Strings\en-US\Resources.resw"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ClipPort\Strings\lzh\Resources.resw"
             Link="Strings\lzh\Resources.resw"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
