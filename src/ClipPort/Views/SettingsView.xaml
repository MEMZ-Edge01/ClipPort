<UserControl
    x:Class="ClipPort.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderNeutralL1Brush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderNeutralL1Brush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="26">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="30" Height="30" CornerRadius="8">
                            <Image Source="ms-appx:///Assets/Icons/clipport-app-icon.png"
                                   Width="30" Height="30" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ClipPort" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="SidebarSettingsLabel" x:Uid="SidebarSettingsLabel" Text="设置" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="7">
                        <TextBlock x:Name="SettingsSectionLabel" x:Uid="SettingsSectionLabel" Text="设置" Margin="10,0,0,3" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Button x:Name="AppearanceNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Click="AppearanceNavButton_Click" Background="{StaticResource ControlSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                                    <Image Source="ms-appx:///Assets/Icons/design-palette.svg" Width="15" Height="15" />
                                </Border>
                                <TextBlock x:Name="AppearanceNavText" x:Uid="AppearanceNavText" Text="外观" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GeneralNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Click="GeneralNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                                    <Image Source="ms-appx:///Assets/Icons/settings.svg" Width="15" Height="15" />
                                </Border>
                                <TextBlock x:Name="GeneralNavText" x:Uid="GeneralNavText" Text="常规" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="QuickStartNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Click="QuickStartNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="#202020" />
                                </Border>
                                <TextBlock x:Name="QuickStartNavText" x:Uid="QuickStartNavText" Text="快速开启" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AboutNavButton" Style="{StaticResource SettingsNavButtonStyle}"
                                Click="AboutNavButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                                    <Image Source="ms-appx:///Assets/Icons/information_simple.svg" Width="15" Height="15" />
                                </Border>
                                <TextBlock x:Name="AboutNavText" x:Uid="AboutNavText" Text="关于" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="2" Click="BackButton_Click" Height="40"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="12,0" Background="{StaticResource ControlSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock x:Name="BackToTaskText" x:Uid="BackToTaskText" Text="返回任务" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="920" HorizontalAlignment="Left" Margin="34,34,34,48">
                <StackPanel x:Name="AppearancePanel" Spacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AppearanceTitle" x:Uid="AppearanceTitle" Text="外观" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="AppearanceDesc" x:Uid="AppearanceDesc" Text="选择应用的明暗外观与强调色。" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="20">
                            <TextBlock x:Name="ColorModeSectionTitle" x:Uid="ColorModeSectionTitle" Text="颜色模式与主题色" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ColorModeLabel" x:Uid="ColorModeLabel" Text="颜色模式" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="ThemeModeComboBox" Grid.Column="1" MinWidth="260"
                                          HorizontalAlignment="Stretch" SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" />
                                    <ComboBoxItem Content="浅色模式" />
                                    <ComboBoxItem Content="深色模式" />
                                </ComboBox>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />
                            <TextBlock x:Name="AccentColorLabel" x:Uid="AccentColorLabel" Text="主题色" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Tag="System" Click="AccentButton_Click" MinWidth="116" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Ellipse Width="20" Height="20" Fill="{StaticResource WindowsAccentPreviewBrush}" />
                                        <TextBlock x:Uid="WinAccentText" Text="Windows 主题色" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="Seafoam" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnSeafoam" ToolTipService.ToolTip="海沫绿">
                                    <Ellipse Width="24" Height="24" Fill="#00B7C3" />
                                </Button>
                                <Button Tag="BrightRose" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnBrightRose" ToolTipService.ToolTip="亮玫红">
                                    <Ellipse Width="24" Height="24" Fill="#EA005E" />
                                </Button>
                                <Button Tag="Gold" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnGold" ToolTipService.ToolTip="黄金色">
                                    <Ellipse Width="24" Height="24" Fill="#FFB900" />
                                </Button>
                                <Button Tag="Mint" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnMint" ToolTipService.ToolTip="浅薄荷色">
                                    <Ellipse Width="24" Height="24" Fill="#00B294" />
                                </Button>
                                <Button Tag="PurpleShadow" Click="AccentButton_Click" Width="54" Height="54"
                                        Background="{StaticResource ControlSecondaryBrush}" x:Uid="AccentBtnPurpleShadow" ToolTipService.ToolTip="紫影色">
                                    <Ellipse Width="24" Height="24" Fill="#8E8CD8" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="AccentSelectionText" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="GeneralPanel" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="GeneralTitle" x:Uid="GeneralTitle" Text="常规" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="GeneralDesc" x:Uid="GeneralDesc" Text="设置界面语言以及日志与报告的默认位置。" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="22">
                            <TextBlock x:Name="LangFileSectionTitle" x:Uid="LangFileSectionTitle" Text="语言与文件" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LanguageLabel" x:Uid="LanguageLabel" Text="语言" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" MinWidth="260"
                                          HorizontalAlignment="Stretch" SelectionChanged="LanguageComboBox_SelectionChanged">
                                </ComboBox>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />
                            <TextBlock x:Name="LogPathLabel" x:Uid="LogPathLabel" Text="日志与报告默认保存位置" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputDirectoryTextBox" IsReadOnly="True"
                                         Background="{StaticResource ControlSecondaryBrush}" />
                                <Button Grid.Column="1" Click="BrowseDirectoryButton_Click"
                                        x:Name="BrowseFolderButton" x:Uid="BrowseFolderButton" Content="选择文件夹" Padding="16,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="QuickStartPanel" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="QuickStartTitle" x:Uid="QuickStartTitle" Text="快速开启" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="QuickStartDesc" x:Uid="QuickStartDesc" Text="从文件资源管理器直接创建并预填 ClipPort 任务。" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="14">
                            <ToggleSwitch x:Name="ExplorerContextMenuToggle"
                                          x:Uid="ExplorerContextMenuToggle"
                                          Header="注册到文件资源管理器右键菜单"
                                          OnContent="已开启"
                                          OffContent="已关闭"
                                          Toggled="ExplorerContextMenuToggle_Toggled" />
                            <TextBlock x:Name="ExplorerContextMenuHint" x:Uid="ExplorerContextMenuHint"
                                       Text="右击文件夹或文件夹空白处，可选择作为源目录或目标目录。"
                                       TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="ExplorerContextMenuStatusText"
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="ShellIntegrationInstallTitle"
                                           x:Uid="ShellIntegrationInstallTitle"
                                           Text="安装与维护" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="ShellIntegrationInstallDesc"
                                           x:Uid="ShellIntegrationInstallDesc"
                                           Text="按顺序完成证书信任、组件安装和功能开启。"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="CertificateInstallStepTitle"
                                               x:Uid="CertificateInstallStepTitle"
                                               Text="1. 安装签名证书" FontWeight="SemiBold" />
                                    <TextBlock x:Name="CertificateInstallStepDesc"
                                               x:Uid="CertificateInstallStepDesc"
                                               Text="请严格按照下面的顺序操作，不要使用向导的默认选项。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <StackPanel Spacing="5" Margin="0,3,0,0">
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep1Prefix" Text="1. 点击右侧的 " />
                                            <Run x:Uid="CertificateGuideStep1Action" Text="打开证书安装向导。" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep2Prefix" Text="2. Windows 弹出证书窗口后，点击 " />
                                            <Run x:Uid="CertificateGuideStep2Action" Text="安装证书..." FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep2Suffix" Text="。" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep3Prefix" Text="3. 在“证书导入向导”的“存储位置”页面，选择 " />
                                            <Run x:Uid="CertificateGuideStep3Location" Text="本地计算机" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep3Suffix" Text="，然后点击下一步。" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep4Prefix" Text="4. 如果 Windows 询问是否允许更改，点击 " />
                                            <Run x:Uid="CertificateGuideStep4Action" Text="是" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep4Suffix" Text="。" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep5Prefix" Text="5. 选择 " />
                                            <Run x:Uid="CertificateGuideStep5StoreMode" Text="将所有的证书都放入下列存储" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep5Middle" Text="，再点击 " />
                                            <Run x:Uid="CertificateGuideStep5Browse" Text="浏览..." FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep5Suffix" Text="。" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep6Prefix" Text="6. 在列表中选择 " />
                                            <Run x:Uid="CertificateGuideStep6Store" Text="受信任人" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep6Middle" Text="，点击确定，然后点击 " />
                                            <Run x:Uid="CertificateGuideStep6Next" Text="下一步" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep6Suffix" Text="。" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep7Prefix" Text="7. 确认“证书存储”显示为 " />
                                            <Run x:Uid="CertificateGuideStep7Store" Text="受信任人" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep7Middle" Text="，点击 " />
                                            <Run x:Uid="CertificateGuideStep7Finish" Text="完成" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep7Suffix" Text="；看到导入成功后关闭窗口。" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                            <Run x:Uid="CertificateGuideStep8Prefix" Text="8. 回到 ClipPort，点击 " />
                                            <Run x:Uid="CertificateGuideStep8Refresh" Text="刷新状态" FontWeight="SemiBold" />
                                            <Run x:Uid="CertificateGuideStep8Suffix" Text="；确认页面提示证书已安装到本地计算机后，再继续安装组件。" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock x:Name="CertificateInstallStatusText"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="InstallCertificateButton"
                                            x:Uid="InstallCertificateButton"
                                            Content="打开证书安装向导"
                                            Click="InstallCertificateButton_Click"
                                            HorizontalAlignment="Stretch" Padding="16,0" Height="40" />
                                    <Button x:Name="UninstallCertificateButton"
                                            x:Uid="UninstallCertificateButton"
                                            Content="卸载证书"
                                            Click="UninstallCertificateButton_Click"
                                            HorizontalAlignment="Stretch" Padding="16,0" Height="40" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="PackageInstallStepTitle"
                                               x:Uid="PackageInstallStepTitle"
                                               Text="2. 安装右键菜单组件" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PackageInstallStepDesc"
                                               x:Uid="PackageInstallStepDesc"
                                               Text="证书安装正确后，点击右侧的“安装组件”，等待页面提示安装成功。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="PackageInstallStatusText"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="InstallShellPackageButton"
                                            x:Uid="InstallShellPackageButton"
                                            Content="安装组件"
                                            Click="InstallShellPackageButton_Click"
                                            HorizontalAlignment="Stretch" Padding="16,0" Height="40" />
                                    <Button x:Name="UninstallShellPackageButton"
                                            x:Uid="UninstallShellPackageButton"
                                            Content="卸载组件"
                                            Click="UninstallShellPackageButton_Click"
                                            HorizontalAlignment="Stretch" Padding="16,0" Height="40" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />

                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock x:Name="EnableMenuStepTitle"
                                               x:Uid="EnableMenuStepTitle"
                                               Text="3. 开启右键菜单" FontWeight="SemiBold" />
                                    <TextBlock x:Name="EnableMenuStepDesc"
                                               x:Uid="EnableMenuStepDesc"
                                               Text="组件安装成功后，打开上方的“注册到文件资源管理器右键菜单”开关。再打开一个新的文件资源管理器窗口，右击文件夹或空白处进行测试。"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button x:Name="RefreshShellIntegrationButton" Grid.Column="1"
                                        x:Uid="RefreshShellIntegrationButton"
                                        Content="刷新状态"
                                        Click="RefreshShellIntegrationButton_Click"
                                        VerticalAlignment="Center" Padding="16,0" Height="40" />
                            </Grid>

                            <InfoBar x:Name="ShellIntegrationGuideInfoBar"
                                     x:Uid="ShellIntegrationGuideInfoBar"
                                     IsOpen="True" IsClosable="False"
                                     Severity="Informational"
                                     Title="安装提示"
                                     Message="测试版使用的是开发证书，所以需要手动安装。正式版如果使用 Windows 已信任的签名证书，通常可以跳过第 1 步。只安装来源和指纹都确认无误的证书。" />
                            <TextBlock x:Name="ShellIntegrationOperationStatusText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AboutPanel" Spacing="24" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AboutTitle" x:Uid="AboutTitle" Text="关于" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutDesc" x:Uid="AboutDesc" Text="查看版本信息并访问 ClipPort 项目仓库。" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="18">
                            <TextBlock x:Name="AppInfoTitle" x:Uid="AppInfoTitle" Text="应用信息" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="VersionLabel" x:Uid="VersionLabel" Text="版本" FontWeight="SemiBold" />
                                <TextBlock x:Name="VersionTextBlock" Grid.Column="1" />
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderNeutralL1Brush}" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RepoLabel" x:Uid="RepoLabel" Text="项目仓库" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="RepositoryButton_Click"
                                        HorizontalAlignment="Left" Padding="14,0" Height="40">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#FFFFFF">
                                            <Image Source="ms-appx:///Assets/Icons/Github.svg" Width="17" Height="17" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="MEMZ-Edge01/ClipPort" FontWeight="SemiBold" />
                                            <TextBlock x:Name="OpenGitHubText" x:Uid="OpenGitHubText" Text="在 GitHub 中打开" FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
