<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClipPort</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\clipport-app-icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0-beta</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-beta</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Icons\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Strings\**\*.resw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <PropertyGroup>
    <NativeCopyOutput>$(MSBuildThisFileDirectory)..\ClipPort.NativeCopy\bin\$(Platform)\$(Configuration)\ClipPort.NativeCopy.dll</NativeCopyOutput>
    <ShellExtensionOutput>$(MSBuildThisFileDirectory)..\ClipPort.ShellExtension\bin\$(Platform)\$(Configuration)\ClipPort.ShellExtension.dll</ShellExtensionOutput>
  </PropertyGroup>

  <Target Name="CopyNativeCopyEngine" AfterTargets="Build"
          Condition="Exists('$(NativeCopyOutput)')">
    <Copy SourceFiles="$(NativeCopyOutput)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishNativeCopyEngine" AfterTargets="ComputeFilesToPublish"
          Condition="Exists('$(NativeCopyOutput)')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(NativeCopyOutput)">
        <RelativePath>ClipPort.NativeCopy.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyShellExtension" AfterTargets="Build"
          Condition="Exists('$(ShellExtensionOutput)')">
    <Copy SourceFiles="$(ShellExtensionOutput)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishShellExtension" AfterTargets="ComputeFilesToPublish"
          Condition="Exists('$(ShellExtensionOutput)')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ShellExtensionOutput)">
        <RelativePath>ClipPort.ShellExtension.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="RequireNativeCopyEngineForPublish" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(RequireNativeCopyEngine)' == 'true' and !Exists('$(NativeCopyOutput)')">
    <Error Text="Required native copy engine was not built: $(NativeCopyOutput)" />
  </Target>
</Project>
