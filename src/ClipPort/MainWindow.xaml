<Window
    x:Class="ClipPort.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ClipPort.Converters"
    xmlns:views="using:ClipPort.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ClipPort-beta">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{StaticResource AppBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="WaveformScaleLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <!-- Labels are anchored to each row's bottom gridline. Move them by
                     half their line height so the glyph center sits on that line. -->
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="6" />
                    </Setter.Value>
                </Setter>
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0"
                Background="{StaticResource TitleBarBrush}"
                BorderBrush="{StaticResource BorderNeutralL1Brush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="6">
                    <Image Source="ms-appx:///Assets/Icons/clipport-app-icon.png"
                           Width="24" Height="24" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="AppTitleText" Text="ClipPort-beta" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid x:Name="TaskWorkspace" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid.Resources>
                    <Style x:Key="JobListItemStyle"
                           TargetType="ListViewItem"
                           BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Background" Value="{StaticResource CardBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderNeutralL1Brush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ListViewItemPresenter
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                        Control.IsTemplateFocusTarget="True"
                                        FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                        FocusVisualPrimaryBrush="{StaticResource AccentBrush}"
                                        FocusVisualPrimaryThickness="2"
                                        FocusVisualSecondaryBrush="{StaticResource WhiteTextBrush}"
                                        FocusVisualSecondaryThickness="1"
                                        SelectionCheckMarkVisualEnabled="False"
                                        SelectionIndicatorVisualEnabled="False"
                                        PlaceholderBackground="{StaticResource PanelBrush}"
                                        PointerOverBackground="{StaticResource OverlayL1Brush}"
                                        PointerOverForeground="{StaticResource DefaultTextBrush}"
                                        SelectedBackground="{StaticResource AccentSelectionPaleBrush}"
                                        SelectedForeground="{StaticResource DefaultTextBrush}"
                                        SelectedPointerOverBackground="{StaticResource AccentSelectionPalePointerOverBrush}"
                                        PressedBackground="{StaticResource OverlayL2Brush}"
                                        SelectedPressedBackground="{StaticResource AccentSelectionPalePressedBrush}"
                                        SelectedDisabledBackground="{StaticResource AccentSelectionPaleBrush}"
                                        DisabledOpacity="0.4"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        ContentMargin="{TemplateBinding Padding}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <DataTemplate x:Key="JobCardTemplate">
                        <Border CornerRadius="8" Padding="18"
                                Loaded="NewJobCard_Loaded" Unloaded="NewJobCard_Unloaded">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                                    <FontIcon Glyph="{Binding StatusGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="14" />
                                    <TextBlock Text="{Binding StatusText, Converter={StaticResource LocalizedTextConverter}}"
                                               FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </Grid.Resources>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,30,16,20" Spacing="10">
                    <StackPanel x:Name="TopButtonRow" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="NewJobButton" Click="ConcurrentNewJobButton_Click"
                                Style="{StaticResource AccentButtonStyle}" Height="36" Padding="10,0"
                                Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource AccentButtonTextBrush}"
                                CornerRadius="7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock x:Name="NewJobButtonText" x:Uid="NewJobButtonText" Text="创建任务" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MultiSelectButton" Click="MultiSelectButton_Click" Height="36" Padding="10,0"
                                Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE762;" FontSize="13" />
                                <TextBlock x:Name="MultiSelectButtonText" x:Uid="MultiSelectButtonText" Text="多选" VerticalAlignment="Center"
                                           FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Click="SettingsButton_Click"
                                Height="36" Padding="10,0"
                                Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7"
                                x:Uid="SettingsToolbarButton" ToolTipService.ToolTip="设置">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="BatchActionPanel" Visibility="Collapsed" Spacing="8">
                        <TextBlock x:Name="BatchSelectionText" x:Uid="BatchSelectionText" Text="已选择 0 个任务"
                                   FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BatchDeleteButton" Click="BatchDeleteButton_Click"
                                    Height="38" Padding="12,0" IsEnabled="False"
                                    Background="{StaticResource ErrorSurfaceL1Brush}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    CornerRadius="7">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                    <TextBlock x:Name="BatchDeleteButtonText" x:Uid="BatchDeleteButtonText" Text="批量删除" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BatchReportButton" Click="BatchReportButton_Click"
                                    Height="38" Padding="12,0" IsEnabled="False"
                                    Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="13" />
                                    <TextBlock x:Name="BatchReportButtonText" x:Uid="BatchReportButtonText" Text="批量创建报告" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="NewTasksSectionHeader" Text="&#x65B0;&#x4EFB;&#x52A1;" Margin="20,0,20,12"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    <ListView x:Name="NewJobsList" Grid.Row="1" MaxHeight="260" Margin="0" Padding="20,0,20,0"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="NewJobsList_ItemClick"
                              SelectionChanged="NewJobsList_SelectionChanged" HorizontalContentAlignment="Stretch"
                              ItemContainerStyle="{StaticResource JobListItemStyle}"
                              ItemTemplate="{StaticResource JobCardTemplate}" />
                    <TextBlock x:Name="NewJobsEmptyText" x:Uid="NewJobsEmptyText" Grid.Row="1" Text="&#x6682;&#x65E0;&#x65B0;&#x4EFB;&#x52A1;"
                               Margin="20,18" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Uid="HistorySectionHeader" Text="历史任务" Margin="20,0,20,12" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    <ListView x:Name="HistoryList" Grid.Row="1" Margin="0" Padding="20,0,20,0"
                              Background="Transparent" BorderThickness="0" SelectionMode="Single"
                              HorizontalContentAlignment="Stretch"
                              SelectionChanged="ConcurrentHistoryList_SelectionChanged"
                              ItemContainerStyle="{StaticResource JobListItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="18">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,10,0,0">
                                            <FontIcon Glyph="{Binding StatusGlyph}" Foreground="{StaticResource AccentBrush}" FontSize="14" />
                                            <TextBlock Text="{Binding StatusText, Converter={StaticResource LocalizedTextConverter}}"
                                                       FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="HistoryEmptyText" x:Uid="HistoryEmptyText" Grid.Row="1" Text="暂无历史任务"
                               Margin="20,18" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                </Grid>
            </Grid>

            <ScrollViewer x:Name="TaskContentScrollViewer" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="TaskContentScrollViewer_SizeChanged">
                <Grid x:Name="TaskContentGrid" Margin="46,32,46,38" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="HeroNameText" x:Uid="HeroNameText" Text="准备新任务" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentFileText" x:Uid="CurrentFileText" Text="请选择源目录和目标目录" Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxWidth="650" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <FontIcon x:Name="CompletionIcon" Glyph="&#xE73E;" FontSize="27"
                                          Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusText" x:Uid="StatusText" Text="等待设置" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PercentText" Text="0.00%" FontSize="32" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Spacing="10">
                                <Button x:Name="StartVerificationButton" Click="ConcurrentStartVerificationButton_Click" Visibility="Collapsed" Height="40"
                                        Padding="16,0" Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13" />
                                        <TextBlock x:Name="StartVerificationButtonText" x:Uid="StartVerificationButtonText" Text="开始校验" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExportReportButton" Click="ConcurrentExportReportButton_Click" Visibility="Collapsed" Height="40"
                                        Padding="16,0" Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                        <TextBlock x:Uid="ExportReportButtonText" Text="导出报告" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteJobButton" Click="ConcurrentDeleteJobButton_Click" Visibility="Collapsed" Height="40"
                                        Padding="16,0" Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock x:Uid="DeleteJobButtonText" Text="删除记录" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RestartJobButton" Click="ConcurrentRestartJobButton_Click" Visibility="Collapsed" Height="40"
                                        Style="{StaticResource AccentButtonStyle}" Padding="16,0" Background="{StaticResource AccentBrush}"
                                        Foreground="{StaticResource AccentButtonTextBrush}" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock x:Name="RestartJobButtonText" x:Uid="RestartJobButtonText" Text="重新开始" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PauseButton" Click="ConcurrentPauseButton_Click" IsEnabled="False" Height="40"
                                        Padding="16,0" Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13" />
                                        <TextBlock x:Name="PauseText" x:Uid="PauseText" Text="暂停" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelButton" Click="ConcurrentCancelButton_Click" IsEnabled="False" Height="40"
                                        Padding="16,0" Background="{StaticResource ControlSecondaryBrush}" CornerRadius="7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        <TextBlock x:Uid="CancelButtonText" Text="取消" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource OverlayL2Brush}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="SourcePathLabel" Text="源目录 / 存储卡" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="SourcePathText" x:Uid="SourcePathText" Text="尚未选择" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="SourcePickerButton" x:Uid="SourcePickerButton" Grid.Column="2" Click="ChooseSourceButton_Click"
                                        ToolTipService.ToolTip="选择源目录" Width="38" Height="38" Padding="0"
                                        Background="Transparent" CornerRadius="7">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="9" Background="{StaticResource OverlayL2Brush}">
                                    <FontIcon Glyph="&#xE838;" FontSize="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Uid="DestinationPathLabel" Text="拷卡目的地" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DestinationPathText" x:Uid="DestinationPathText" Text="尚未选择" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button x:Name="DestinationPickerButton" x:Uid="DestinationPickerButton" Grid.Column="2" Click="ChooseDestinationButton_Click"
                                        ToolTipService.ToolTip="选择目标目录" Width="38" Height="38" Padding="0"
                                        Background="Transparent" CornerRadius="7">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="34" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock x:Name="TotalSizeText" Text="--" FontWeight="SemiBold" />
                                <TextBlock x:Uid="FileSizeLabel" Text="文件大小" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="TotalCountText" Text="--" FontWeight="SemiBold" />
                                <TextBlock x:Uid="FileCountLabel" Text="文件数" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="StartTimeText" Text="--" FontWeight="SemiBold" />
                                <TextBlock x:Uid="CreatedTimeLabel" Text="创建时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="EndTimeText" Text="--" FontWeight="SemiBold" />
                                <TextBlock x:Uid="EndTimeLabel" Text="结束时间" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DurationText" Text="--" FontWeight="SemiBold" />
                                <TextBlock x:Uid="ElapsedTimeLabel" Text="累计用时" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button x:Name="StartButton" Click="ConcurrentStartButton_Click"
                                    Style="{StaticResource AccentButtonStyle}" Padding="22,10"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="{StaticResource AccentButtonTextBrush}"
                                    CornerRadius="7" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                    <TextBlock x:Uid="StartButtonText" Text="开始拷卡" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Margin="0,26,0,0" Background="{StaticResource PanelBrush}" CornerRadius="10">
                        <StackPanel>
                            <Grid Padding="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                    <TextBlock x:Uid="ProgressSectionTitle" Text="任务进度" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="PhaseText" x:Uid="PhaseText" Text="等待开始" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </Grid>

                            <ProgressBar x:Name="OverallProgress" Height="4" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource ProgressTrackBrush}" />

                            <Grid x:Name="CopyProgressRow" Padding="20,17" Background="{StaticResource CardOverlayBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="CopySectionLabel" Text="拷贝" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Margin="0,0,28,0">
                                    <ProgressBar x:Name="CopyProgress" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" />
                                    <Border x:Name="CopyCompletedBadge" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
                                            <TextBlock x:Name="CopyCompletedText" x:Uid="CopyCompletedText" Text="已完成" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" x:Name="CopySpeedText" Text="0 B/s" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" x:Name="CopyTimeText" Text="00:00:00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" x:Name="CopyCountText" Text="0/0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid x:Name="VerifyProgressRow" Padding="20,17" Background="{StaticResource SuccessSurfaceL1Brush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="VerifySectionLabel" Text="文件校验" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Margin="0,0,28,0">
                                    <ProgressBar x:Name="VerifyProgress" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource SuccessBrush}" />
                                    <Border x:Name="VerifyCompletedBadge" Visibility="Collapsed" Background="{StaticResource SuccessBrush}" CornerRadius="5" Padding="12,5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource OnBrandTextBrush}" />
                                            <TextBlock x:Name="VerifyCompletedText" x:Uid="VerifyCompletedText" Text="已完成" FontWeight="SemiBold" Foreground="{StaticResource OnBrandTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" x:Name="VerifySpeedText" Text="0 B/s" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" x:Name="VerifyTimeText" Text="00:00:00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" x:Name="VerifyCountText" Text="0/0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DuplicatePanel" Grid.Row="4" Margin="0,18,0,0"
                            Background="{StaticResource PanelBrush}" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Padding="20,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="9">
