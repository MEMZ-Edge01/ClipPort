                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock x:Uid="VerifyItemRateChartTitle" Text="项目数速度"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="VerifyItemRateCurrentText" Text="0.00 items/s"
                                                   HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource VerificationChartBrush}" />
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,14,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderNeutralL1Brush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="1" BorderBrush="{StaticResource BorderNeutralL1Brush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderNeutralL1Brush}" BorderThickness="0,0,0,1" />
                                            <Border Grid.Row="3" BorderBrush="{StaticResource BorderNeutralL1Brush}" BorderThickness="0,0,0,1" />
                                        </Grid>
                                        <Canvas x:Name="VerifyItemRateCanvas" SizeChanged="ThroughputChart_SizeChanged">
                                            <Polygon x:Name="VerifyItemRateFill" Fill="{StaticResource VerificationChartBrush}"
                                                     Opacity="0.20" IsHitTestVisible="False" />
                                            <Polyline x:Name="VerifyItemRateGlow" Stroke="{StaticResource VerificationChartBrush}"
                                                      StrokeThickness="7" Opacity="0.18" StrokeLineJoin="Round" />
                                            <Polyline x:Name="VerifyItemRateLine" Stroke="{StaticResource VerificationChartBrush}"
                                                      StrokeThickness="2.5" StrokeLineJoin="Round" />
                                        </Canvas>
                                        <Grid x:Name="VerifyItemRateScaleLabels" Grid.Column="1" Margin="8,0,0,0"
                                              IsHitTestVisible="False">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Style="{StaticResource WaveformScaleLabelStyle}" Text="0" />
                                            <TextBlock Grid.Row="1" Style="{StaticResource WaveformScaleLabelStyle}" Text="0" />
                                            <TextBlock Grid.Row="2" Style="{StaticResource WaveformScaleLabelStyle}" Text="0" />
                                            <TextBlock Grid.Row="3" Style="{StaticResource WaveformScaleLabelStyle}" Text="0" />
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock x:Name="VerifyItemRateMaximumText" Text="↑ 0.00 items/s"
                                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock x:Name="VerifyItemRateMinimumText" Text="↓ 0.00 items/s"
                                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="VerifyItemRateUnitText" Grid.Column="1" Text="items/s"
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
        <views:SettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" />
        <ContentDialog x:Name="NewTaskDialog" x:Uid="NewTaskDialog" Grid.RowSpan="2" Title="新建拷卡任务"
                       PrimaryButtonText="开始任务" CloseButtonText="取消" DefaultButton="Primary">
            <ScrollViewer Width="500" MaxHeight="590" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Padding="0,4,0,2">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B7;" FontSize="19" />
                            <TextBlock x:Name="DialogSourceLabel" x:Uid="DialogSourceLabel" Text="数据源" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="DialogSourceButton" Click="DialogSourceButton_Click" Height="76"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="{StaticResource CardOverlayBrush}" CornerRadius="7" Padding="18,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="24" />
                                <TextBlock x:Name="DialogSourcePathText" x:Uid="DialogSourcePathText" Grid.Column="1" Margin="14,0,0,0"
                                           Text="请选择源目录或存储卡" Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="19" />
                            <TextBlock x:Name="DialogCopyLabel" x:Uid="DialogCopyLabel" Text="拷贝" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="DialogCopyDestLabel" x:Uid="DialogCopyDestLabel" Text="拷贝目的地" FontWeight="SemiBold" />
                        <Button x:Name="DialogDestinationButton" Click="DialogDestinationButton_Click" Height="76"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="{StaticResource CardOverlayBrush}" CornerRadius="7" Padding="18,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="24" />
                                <TextBlock x:Name="DialogDestinationPathText" x:Uid="DialogDestinationPathText" Grid.Column="1" Margin="14,0,0,0"
                                           Text="请选择文件拷贝目的地" Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                       </Button>
                    </StackPanel>
                    <StackPanel Spacing="9">
                        <ToggleSwitch x:Name="EnableCopyToggle" x:Uid="EnableCopyToggle" Header="拷贝文件" IsOn="True"
                                      OnContent="开启" OffContent="关闭" HorizontalAlignment="Stretch" />
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DestinationSubfolderNameLabel" x:Uid="DestinationSubfolderNameLabel" Text="拷贝目的地文件夹名" Foreground="{StaticResource DefaultTextBrush}" />
                            <TextBox x:Name="DialogDestinationSubfolderName"
                                     PlaceholderText=""
                                     HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="DestinationSubfolderHintText" x:Uid="DestinationSubfolderHintText" Text="留空即不创建子文件夹" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DuplicateHandlingLabel" x:Uid="DuplicateHandlingLabel" Text="重复项处理" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                            <RadioButton x:Name="AskExistingRadio" x:Uid="AskExistingRadio" Content="询问" IsChecked="True"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                            <RadioButton x:Name="OverwriteExistingRadio" x:Uid="OverwriteExistingRadio" Content="覆盖"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                            <RadioButton x:Name="SkipExistingRadio" x:Uid="SkipExistingRadio" Content="跳过"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                            <RadioButton x:Name="CreateCopyRadio" x:Uid="CreateCopyRadio" Content="创建副本"
                                         GroupName="DuplicatePolicy" MinWidth="0" Padding="8,6" />
                        </StackPanel>
                        <TextBlock x:Name="DuplicateAskHintText" x:Uid="DuplicateAskHintText" Text="询问模式会先继续处理其他文件，再逐个处理检测到的重复文件。"
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="5" Visibility="Collapsed">
                        <ToggleSwitch x:Name="UseFastCopyAlgorithmToggle" x:Uid="FastCopyToggle"
                                      IsEnabled="False"
                                      Header="使用 FastCopy 算法"
                                      OffContent="关闭"
                                      OnContent="开启"
                                      IsOn="False"
                                      HorizontalAlignment="Stretch" />
                        <TextBlock x:Uid="FastCopyHintText" Text="使用原生流水线复制引擎；不可用时自动回退到托管流水线。文件大小、进度和剩余时间仍会正常显示。"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="VerifyFilesToggle" x:Uid="VerifyFilesToggle" Header="文件校验" IsOn="True"
                                  OnContent="开启" OffContent="关闭" HorizontalAlignment="Stretch"
                                  Toggled="VerifyFilesToggle_Toggled" />
                    <StackPanel x:Name="OpportunisticVerificationPanel" Spacing="5">
                        <ToggleSwitch x:Name="OpportunisticVerificationToggle"
                                      x:Uid="OpportunisticVerificationToggle"
                                      Header="拷贝时校验"
                                      OnContent="开启"
                                      OffContent="关闭"
                                      IsOn="False"
                                      HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="OpportunisticVerificationHintText"
                                   x:Uid="OpportunisticVerificationHintText"
                                   Text="使用低优先级后台资源校验已完成文件；资源不足时会在复制结束后补完。"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="VerificationAlgorithmLabel" x:Uid="VerificationAlgorithmLabel"
                                   Text="校验算法" Foreground="{StaticResource DefaultTextBrush}" />
                        <ComboBox x:Name="VerificationAlgorithmComboBox" SelectedIndex="0"
                                  SelectionChanged="VerificationAlgorithmComboBox_SelectionChanged"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Tag="Sha256" Content="SHA-256" />
                            <ComboBoxItem Tag="Sha512" Content="SHA-512" />
                            <ComboBoxItem Tag="Sha1" Content="SHA-1" />
                            <ComboBoxItem Tag="Md5" Content="MD5" />
                            <ComboBoxItem Tag="XxHash64" Content="xxHash64" />
                        </ComboBox>
                        <TextBlock x:Name="VerificationAlgorithmHintText" x:Uid="VerificationAlgorithmHintText"
                                   Text="默认选择，兼顾速度与抗碰撞能力，适合重要素材交付与长期归档。"
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="PreventSleepToggle" x:Uid="PreventSleepToggle"
                                  Header="&#x4EFB;&#x52A1;&#x671F;&#x95F4;&#x963B;&#x6B62;&#x7535;&#x8111;&#x4F11;&#x7720;"
                                  OnContent="开启" OffContent="关闭"
                                  IsOn="True" HorizontalAlignment="Stretch" />
                    <StackPanel Spacing="5">
                        <ToggleSwitch x:Name="PriorityExecutionToggle" x:Uid="PriorityExecutionToggle"
                                      Header="&#x4F18;&#x5148;&#x6267;&#x884C;"
                                      OffContent="&#x5173;&#x95ED;" OnContent="&#x5F00;&#x542F;"
                                      IsOn="False"
                                      HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="PriorityHintText" x:Uid="PriorityHintText" Text="&#x4F18;&#x5148;&#x4EFB;&#x52A1;&#x4F1A;&#x5E76;&#x884C;&#x6267;&#x884C;&#xFF1B;&#x5176;&#x4ED6;&#x4EFB;&#x52A1;&#x5C06;&#x5728;&#x5B89;&#x5168;&#x68C0;&#x67E5;&#x70B9;&#x7B49;&#x5F85;&#xFF0C;&#x76F4;&#x5230;&#x5168;&#x90E8;&#x4F18;&#x5148;&#x4EFB;&#x52A1;&#x7ED3;&#x675F;&#x3002;"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>    </Grid>
</Window>
