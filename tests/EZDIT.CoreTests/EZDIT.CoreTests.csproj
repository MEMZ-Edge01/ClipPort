<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\EZDIT\Models\AppSettings.cs" Link="Models\AppSettings.cs" />
    <Compile Include="..\..\src\EZDIT\Models\CopyModels.cs" Link="Models\CopyModels.cs" />
    <Compile Include="..\..\src\EZDIT\Models\JobHistoryItem.cs" Link="Models\JobHistoryItem.cs" />
    <Compile Include="..\..\src\EZDIT\Services\FileCopyService.cs" Link="Services\FileCopyService.cs" />
    <Compile Include="..\..\src\EZDIT\Services\NativeCopyEngine.cs" Link="Services\NativeCopyEngine.cs" />
    <Compile Include="..\..\src\EZDIT\Services\JobHistoryService.cs" Link="Services\JobHistoryService.cs" />
    <Compile Include="..\..\src\EZDIT\Services\CopyJobScheduler.cs" Link="Services\CopyJobScheduler.cs" />
    <Compile Include="..\..\src\EZDIT\Services\ResourceService.cs" Link="Services\ResourceService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\EZDIT\MainWindow.xaml"
             Link="Localization\MainWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\EZDIT\Views\SettingsView.xaml"
             Link="Localization\SettingsView.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\EZDIT\Strings\zh-CN\Resources.resw"
             Link="Strings\zh-CN\Resources.resw"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\EZDIT\Strings\en-US\Resources.resw"
             Link="Strings\en-US\Resources.resw"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
